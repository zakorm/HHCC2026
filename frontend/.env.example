# Only needed for testing on a physical device via Expo Go, where the phone's
# own "localhost" isn't the dev machine. Set this to your Mac's LAN IP and
# start the Django server with `python manage.py runserver 0.0.0.0:8000`.
# Web/iOS Simulator/Android Emulator all have working defaults without this.
EXPO_PUBLIC_API_URL=http://192.168.1.x:8000/api/v1
